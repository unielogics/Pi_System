[Unit]
Description=Dimensioner network-reachability watchdog (pings gateway, reconnects WiFi on failure)
After=network-online.target systemd-time-wait-sync.service
Wants=network-online.target systemd-time-wait-sync.service

[Service]
Type=oneshot
User=unie
WorkingDirectory=/home/unie/dimensioner
EnvironmentFile=-/home/unie/dimensioner/.env
ExecStart=/home/unie/micromamba/bin/micromamba run -n ros2 python network_watchdog.py
