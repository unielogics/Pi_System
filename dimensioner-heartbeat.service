[Unit]
Description=Dimensioner device self-registration heartbeat (calls WMS backend, updates DNS on IP change)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=unie
WorkingDirectory=/home/unie/dimensioner
EnvironmentFile=-/home/unie/dimensioner/.env
ExecStart=/home/unie/micromamba/bin/micromamba run -n ros2 python registration.py
