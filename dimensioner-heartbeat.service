[Unit]
Description=Dimensioner device self-registration heartbeat (calls WMS backend, updates DNS on IP change)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=franco
WorkingDirectory=/home/franco/dimensioner
EnvironmentFile=-/home/franco/dimensioner/.env
ExecStart=/home/franco/micromamba/bin/micromamba run -n ros2 python registration.py
