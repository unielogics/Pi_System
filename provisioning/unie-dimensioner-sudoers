# Grants the `unie` user passwordless sudo for EXACTLY the commands the dimensioner's two
# watchdogs need to self-heal -- never a blanket NOPASSWD:ALL. Install with:
#   sudo install -m 0440 provisioning/unie-dimensioner-sudoers /etc/sudoers.d/unie-dimensioner
# (0440 and the /etc/sudoers.d/ location are required -- sudo silently ignores files with looser
# permissions or a different owner/group in that directory.)
#
# api.py's in-process camera watchdog (_watchdog_loop) restarts the ROS driver when frames go
# stale; network_watchdog.py reconnects the network interface when the gateway stops responding.
# Both run as `unie` (see dimensioner-api.service/dimensioner-network-watchdog.service's User=
# directive) and call `sudo -n ...` (non-interactive -- fails immediately rather than hanging on
# a password prompt neither watchdog can ever answer).
#
# The nmcli rules below MUST list every interface any device in this fleet actually uses -- this
# fleet has BOTH wired (eth0, confirmed on WH-007's ED1) and WiFi (wlan0) devices, and sudo does
# not support wildcards in place of the interface name. Add a matching pair of NOPASSWD lines
# here for any new interface name a future device introduces (network_watchdog.py detects the
# right interface automatically from the routing table -- this file just needs to permit
# whichever ones actually exist in the fleet).
unie ALL=(root) NOPASSWD: /usr/bin/systemctl restart dimensioner-ros.service
unie ALL=(root) NOPASSWD: /usr/bin/systemctl restart dimensioner-api.service
unie ALL=(root) NOPASSWD: /usr/bin/nmcli device disconnect eth0
unie ALL=(root) NOPASSWD: /usr/bin/nmcli device connect eth0
unie ALL=(root) NOPASSWD: /usr/bin/nmcli device disconnect wlan0
unie ALL=(root) NOPASSWD: /usr/bin/nmcli device connect wlan0

# auto_update.py (dimensioner-auto-update.timer, once nightly) needs to reapply a changed unit
# file's installation steps the same way a human would per README.md -- reload systemd's view of
# unit files, re-enable one that changed, and copy the updated file from the repo into
# /etc/systemd/system/. The `cp` glob is a sudoers pathname pattern (fnmatch), not a shell glob --
# it only matches files directly inside /home/unie/dimensioner/, so a compromised git history
# still can't use this rule to overwrite an arbitrary system path.
unie ALL=(root) NOPASSWD: /usr/bin/systemctl daemon-reload
unie ALL=(root) NOPASSWD: /usr/bin/systemctl enable dimensioner-*.service
unie ALL=(root) NOPASSWD: /usr/bin/systemctl enable dimensioner-*.timer
unie ALL=(root) NOPASSWD: /usr/bin/cp /home/unie/dimensioner/*.service /etc/systemd/system/
unie ALL=(root) NOPASSWD: /usr/bin/cp /home/unie/dimensioner/*.timer /etc/systemd/system/

# The on-demand "Update Now" dashboard button (POST /update-now in api.py) needs to start the
# auto-update oneshot unit outside its normal overnight schedule, without auto_update.py running
# in-process (which would restart THIS process, api.py, mid-request -- see /update-now's
# docstring). `start` (not `restart`) is correct: the unit is Type=oneshot and normally inactive
# between runs, so `start` is what actually invokes it on demand.
unie ALL=(root) NOPASSWD: /usr/bin/systemctl start dimensioner-auto-update.service
