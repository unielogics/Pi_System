[Unit]
Description=Dimensioner self-update (git pull from unielogics/Pi_System, restarts app on new commit)
After=network-online.target systemd-time-wait-sync.service
Wants=network-online.target systemd-time-wait-sync.service

[Service]
Type=oneshot
User=unie
WorkingDirectory=/home/unie/dimensioner
EnvironmentFile=-/home/unie/dimensioner/.env
ExecStart=/home/unie/micromamba/bin/micromamba run -n ros2 python auto_update.py
